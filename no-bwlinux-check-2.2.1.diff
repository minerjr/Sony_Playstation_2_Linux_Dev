diff -burN linux-2.2.1-ps2-7.orig/arch/mips/ps2/sbios/init.c linux-2.2.1-ps2-7/arch/mips/ps2/sbios/init.c
--- linux-2.2.1-ps2-7.orig/arch/mips/ps2/sbios/init.c	Wed Nov 14 03:17:39 2001
+++ linux-2.2.1-ps2-7/arch/mips/ps2/sbios/init.c	Sun Nov 17 12:04:14 2002
@@ -31,6 +31,7 @@
 {
 	struct ps2_bootinfo *bootinfo;
 	int oldbootinfo = 0;
+	int version;
 
 	/* default bootinfo */
 	memset(&ps2_bootinfox, 0, sizeof(struct ps2_bootinfo));
@@ -86,6 +87,13 @@
 	       bootinfo, oldbootinfo ? "(old style)" : "");
 	printk("boot option string at 0x%08x: %s\n",
 	       ps2_bootinfo->opt_string, arcs_cmdline);
+
+	/* Disable the check for the BWLINUX/ prefix */
+	version = sbios(SB_GETVER, 0);
+	if (version == 0x200)		/* Beta kit */
+		*(unsigned char *)0x80007c20 = 0;
+	else if (version == 0x250)	/* 1.0 kit */
+		*(unsigned char *)0x800081b0 = 0;
 
 	return 0;
 }
